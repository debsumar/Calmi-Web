{
  "name": "calmi-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "set-license": "node scripts/set-license.mjs",
    "institutions:refresh": "node scripts/build-institutions.mjs",
    "prestart": "npm run set-license",
    "start": "ng serve",
    "prestart:prod": "npm run set-license",
    "start:prod": "ng serve --configuration production",
    "prebuild": "npm run set-license",
    "build": "ng build",
    "prebuild:dev": "npm run set-license",
    "build:dev": "ng build --configuration development",
    "prewatch": "npm run set-license",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run set-license",
    "test": "ng test",
    "test:safe": "node scripts/run-tests.mjs",
    "test:watch": "ng test --watch",
    "test:chat": "ng test --include=src/app/features/chat/**/*.spec.ts",
    "test:coverage": "ng test --coverage",
    "typecheck:server": "tsc -p api/tsconfig.json --noEmit",
    "predev:api": "npm run set-license",
    "dev:api": "vercel dev"
  },
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@lucide/angular": "1.59.0",
    "@primeuix/themes": "^3.0.1",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/postcss": "^4.3.3",
    "jwt-decode": "^4.0.0",
    "livekit-client": "2.23.0",
    "primeicons": "^8.0.2",
    "primeng": "^22.1.2",
    "rxjs": "^7.8.2",
    "tailwindcss-primeui": "^0.6.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@eslint/js": "^10.0.1",
    "@primeuix/styled": "1.0.0",
    "@types/node": "24.19.2",
    "@vercel/node": "24.0.3",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.13.0",
    "jsdom": "30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "5.0.5"
  }
}
