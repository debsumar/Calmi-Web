# Copy to .env.local and fill in your own key (see https://primeui.dev/licenses/community).
# .env.local is gitignored; never commit a real key.
PRIMEUI_LICENSE_KEY=

# Brevo waitlist (api/waitlist.ts). Server-side only - these are read via
# process.env inside the Vercel function and must never be added to
# src/environments/*, which is compiled into the browser bundle.
# Set the real values in the Vercel dashboard, then run `vercel env pull`.
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
